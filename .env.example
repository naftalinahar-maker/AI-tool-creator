# Everything below is OPTIONAL. With no keys at all the app still works for free:
#   - ideas + screenplays: built-in generator (or Claude on your own account when
#     opened as a claude.ai artifact link)
#   - scene visuals: free AI images from Pollinations.ai (no key), animated by the player

# --- Claude (ideas + screenplays on the server). Paid per use. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Free AI images (default). Set to 1 to turn off.
DISABLE_POLLINATIONS=
# POLLINATIONS_MODEL=flux

# --- Real AI video clips (4-10 s per scene). PAID per clip; used only if a key is set.
# The engine tries providers in this order and falls back to the next one on failure.
# Google Veo via the Gemini API
GEMINI_API_KEY=
# VEO_MODEL=veo-3.1-generate-preview

# fal.ai
FAL_KEY=
# FAL_VIDEO_MODEL=fal-ai/kling-video/v2.1/master/text-to-video

# Replicate
REPLICATE_API_TOKEN=
# REPLICATE_VIDEO_MODEL=minimax/hailuo-02

# Runway
RUNWAYML_API_SECRET=
# RUNWAY_VIDEO_MODEL=gen4.5
# RUNWAY_API_VERSION=2024-11-06
